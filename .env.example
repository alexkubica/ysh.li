# Instagram API Configuration
# Get these from Meta for Developers (https://developers.facebook.com/)

# Instagram Access Token (for Instagram Basic Display API or Instagram Graph API)
# This is a long-lived access token for your Instagram Business account
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Instagram Account ID (Business Account ID)
# Your Instagram Business account ID - can be found in Meta Business settings
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Base URL for your application (used for temporary file serving)
# In production, use your actual domain
NEXT_PUBLIC_BASE_URL=http://localhost:3000